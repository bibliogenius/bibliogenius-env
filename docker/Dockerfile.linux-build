# Linux x64 build toolchain for BiblioGenius (producer side).
#
# Builds the Rust backend + Flutter Linux release bundle and emits
# BiblioGenius-Linux-x64.tar.gz. The runtime/test side lives in
# Dockerfile.linux-app (GTK runtime + VNC + verify_linux.sh).
#
# glibc note: built on Ubuntu 22.04 LTS on purpose. The bundle links against
# this image's glibc, so a not-too-recent LTS maximises compatibility with the
# distros our users run. Do NOT bump to 24.04 without a compatibility reason.
#
# On Apple Silicon this image is built and run under linux/amd64 via qemu
# emulation (slow but reproducible). See `make build-linux`.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    PATH=/opt/cargo/bin:/opt/flutter/bin:/usr/local/bin:/usr/bin:/bin

# Build dependencies (see project_windows_linux_desktop_release memory for the
# canonical Flutter-Linux + Rust dep list).
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang cmake ninja-build pkg-config \
    libgtk-3-dev liblzma-dev libglu1-mesa-dev libstdc++-12-dev \
    libsecret-1-dev libsqlite3-dev libssl-dev \
    curl git unzip xz-utils ca-certificates file \
    && rm -rf /var/lib/apt/lists/*

# Runs as root: this is a throwaway BUILD container (Flutter only warns when
# building as root, never refuses), and Docker Desktop on macOS remaps
# bind-mount writes back to the host user. The non-root user matters only for
# the runtime image (Dockerfile.linux-app), not here.

# Rust toolchain (native target = x86_64-unknown-linux-gnu under amd64).
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --default-toolchain stable --profile minimal

# Flutter SDK, pinned to match the app's Dart SDK constraint (pubspec ^3.10.x).
ARG FLUTTER_VERSION=3.38.4
RUN git clone --depth 1 --branch ${FLUTTER_VERSION} \
      https://github.com/flutter/flutter.git /opt/flutter

COPY build-linux.sh /usr/local/bin/build-linux.sh
RUN chmod +x /usr/local/bin/build-linux.sh

RUN git config --global --add safe.directory '*' \
    && flutter config --no-analytics --enable-linux-desktop \
    && flutter precache --linux

# OpenSSL + extra C toolchain. Appended AFTER the slow flutter precache layer so
# editing this never busts that cache. build-essential provides make/gcc for
# C-building crates (rusqlite bundled, etc.). OPENSSL_NO_VENDOR makes openssl-sys
# link the system libssl-dev instead of compiling the vendored copy from source
# (needs make, very slow under qemu) — the runtime image already ships libssl3,
# so dynamic linking is the intended model.
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
ENV OPENSSL_NO_VENDOR=1

# Repos are bind-mounted at run time under /src (siblings, as in local dev):
#   /src/bibliogenius      (Rust)
#   /src/bibliogenius-app  (Flutter)
# Output tarball is written to /out.
WORKDIR /src/bibliogenius-app
ENTRYPOINT ["/usr/local/bin/build-linux.sh"]
