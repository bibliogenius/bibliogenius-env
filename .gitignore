# Ignore everything by default (sub-repos have their own git)
*
.DS_Store

# ── Track: project-level config ──
!.gitignore
!AGENTS.md
!CLAUDE.md
!GEMINI.md
!.cursorrules
!.windsurfrules
!Makefile
!setup.py
!README.md
!CONTRIBUTING.

# ── Track: Claude Code config ──
!.claude/
!.claude/**
# Exclude local/ephemeral files
.claude/settings.local.json
.claude/session-logs/**
# Exclude skills (symlinks to .agents/)
.claude/skills/

# ── Track: shared skills source ──
!.agents/
!.agents/**
.agents/**/.DS_Store

# ── Track: public documentation ──
!docs/
!docs/**
docs/**/.DS_Store

# ── Track: Docker environment ──
!docker/
!docker/**

# ── Track: submodule definitions ──
!.gitmodules
